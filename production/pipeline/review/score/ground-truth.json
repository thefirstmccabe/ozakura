  "tone": "tone: edgy, brooding, quippy, trying too hard",
  "flat": "flat, or doesn't land",
  "overplayed": "overplayed or repeated beat",
  "callback": "callback that needs memory",
  "term": "untranslated term",
  "staging": "staging or art against text",
  "look-voice": "character look or voice (design, casting, pitch)",
  "engine": "engine or layout",
  "story": "story decision or content request",
  "continuity": "fact against canon"
 },
 "catchable": {
  "text": "a reader of the text and the CGs could notice it",
  "screen": "needs the screen as played (layout, sprites and expressions, motion, timing)",
  "script": "needs the source (music cues, staging tags)",
  "neither": "by ear, the author's taste or plans, or a design choice"
 },
